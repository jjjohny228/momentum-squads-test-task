{
  "info": {
    "name": "Momentum Support",
    "description": "Support-ticket drafting service + mock helpdesk.\n\nRun the whole collection (Runner / newman) for the end-to-end scenario: webhook -> duplicate -> draft -> approve -> exactly one reply in the mock helpdesk.\nUse the `local` environment; `replyBaseUrl` is the mock helpdesk address as seen from the worker container.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "pollCount",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body is OK\", () => pm.expect(pm.response.text()).to.eql(\"OK\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Webhook",
      "item": [
        {
          "name": "New ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhooks/helpdesk",
            "description": "Helpdesk delivers a new event. Answers in milliseconds; drafting happens in the worker.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"ticket_id\": \"{{externalTicketId}}\",\n  \"customer_email\": \"user@example.com\",\n  \"message\": \"Не можу експортувати звіт у PDF\",\n  \"reply_url\": \"{{replyBaseUrl}}/tickets/{{externalTicketId}}/replies\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('eventId', 'evt_' + pm.variables.replaceIn('{{$guid}}').slice(0, 12));",
                  "pm.environment.set('externalTicketId', 'T-' + Math.floor(Math.random() * 90000 + 10000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"accepted\", () => pm.expect(body.status).to.eql(\"accepted\"));",
                  "pm.test(\"fast (< 2 s)\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.environment.set('ticketId', body.ticket_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate delivery (same event_id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhooks/helpdesk",
            "description": "Re-delivery is acknowledged with 200 and does not create a second ticket.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"ticket_id\": \"{{externalTicketId}}\",\n  \"customer_email\": \"user@example.com\",\n  \"message\": \"Не можу експортувати звіт у PDF\",\n  \"reply_url\": \"{{replyBaseUrl}}/tickets/{{externalTicketId}}/replies\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"duplicate\", () => pm.expect(pm.response.json().status).to.eql(\"duplicate\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhooks/helpdesk",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt_x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "reply_url host not allowed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhooks/helpdesk",
            "description": "Only hosts from REPLY_URL_ALLOWED_HOSTS are accepted (SSRF protection).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt_ssrf_{{$timestamp}}\",\n  \"ticket_id\": \"{{externalTicketId}}\",\n  \"customer_email\": \"user@example.com\",\n  \"message\": \"Не можу експортувати звіт у PDF\",\n  \"reply_url\": \"http://169.254.169.254/latest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tickets API",
      "item": [
        {
          "name": "Wait until draft is ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
            "description": "Polls the ticket (LLM takes 5-30 s). Outside the runner just re-send it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json();",
                  "const n = Number(pm.collectionVariables.get('pollCount') || 0);",
                  "if (!(t.status === 'draft_ready') && n < 80) {",
                  "  pm.collectionVariables.set('pollCount', n + 1);",
                  "  setTimeout(() => {}, 1500);",
                  "  pm.execution.setNextRequest('Wait until draft is ready');",
                  "} else {",
                  "  pm.collectionVariables.set('pollCount', 0);",
                  "  pm.test('reached expected state', () => pm.expect(t.status === 'draft_ready').to.be.true);",
                  "}",
                  "if (t.status === 'draft_ready') {",
                  "  pm.test('draft has KB links', () => pm.expect(t.draft).to.include('/kb/'));",
                  "  pm.test('sources found', () => pm.expect(t.sources.length).to.be.above(0));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets?limit=20",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"page\", () => pm.expect(pm.response.json().items).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List tickets with drafts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets?status=draft_ready",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"only draft_ready\", () => pm.response.json().items.forEach(i => pm.expect(i.status).to.eql(\"draft_ready\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ticket",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve (with edited text)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/approve",
            "description": "Body is optional: without `message` the generated draft is sent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Вітаємо! Щоб експортувати звіт у PDF, відкрийте звіт і натисніть Експорт → PDF.\\n\\nКорисні статті:\\n- Як експортувати звіт у PDF: http://localhost:8000/kb/export-pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"approved\", () => pm.expect(pm.response.json().status).to.eql(\"approved\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve again -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/approve",
            "description": "Double approval never enqueues a second send."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait until sent",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
            "description": "Sending is retried on helpdesk 5xx/timeouts with the same Idempotency-Key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json();",
                  "const n = Number(pm.collectionVariables.get('pollCount') || 0);",
                  "if (!(t.status === 'sent') && n < 80) {",
                  "  pm.collectionVariables.set('pollCount', n + 1);",
                  "  setTimeout(() => {}, 1500);",
                  "  pm.execution.setNextRequest('Wait until sent');",
                  "} else {",
                  "  pm.collectionVariables.set('pollCount', 0);",
                  "  pm.test('reached expected state', () => pm.expect(t.status === 'sent').to.be.true);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject sent ticket -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/reject",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry non-failed ticket -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/retry",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown ticket -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tickets/00000000-0000-0000-0000-000000000000",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Knowledge base",
      "item": [
        {
          "name": "List articles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/kb",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has articles\", () => pm.expect(pm.response.json().length).to.be.within(5, 10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Article page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/kb/export-pdf",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"html\", () => pm.expect(pm.response.text()).to.include(\"PDF\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mock helpdesk",
      "item": [
        {
          "name": "Replies for the ticket (exactly one)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mockUrl}}/replies?ticket_id={{externalTicketId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"exactly one reply delivered\", () => pm.expect(r.items.length).to.eql(1));",
                  "pm.test(\"no ticket got two replies\", () => pm.expect(r.tickets_with_multiple_replies).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get chaos config",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mockUrl}}/config",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set chaos config",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mockUrl}}/config",
            "description": "Probability of 503 and of a slow response (stored, but the caller times out).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failure_rate\": 0.2,\n  \"slow_rate\": 0.1,\n  \"slow_seconds\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate ticket with concurrent duplicates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mockUrl}}/simulate/tickets",
            "description": "The mock fires the webhook like the real helpdesk: 2 s timeout, retries, concurrent duplicates.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Забув пароль, не можу увійти\",\n  \"concurrent_duplicates\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const statuses = pm.response.json().deliveries.map(d => d.response.status).sort();",
                  "pm.test(\"one accepted, rest duplicates\", () => pm.expect(statuses).to.eql([\"accepted\", \"duplicate\", \"duplicate\", \"duplicate\", \"duplicate\"]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}