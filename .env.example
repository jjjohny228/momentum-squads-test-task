# Copy to .env (optional). Without OPENAI_API_KEY the service runs in keyless mode:
# requests still go to OpenAI, static drafts are returned after a 5-30 s delay.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Global provider budget (chat + embeddings), shared by all workers
RATE_LIMIT_RPM=60
RATE_LIMIT_INCLUDE_EMBEDDINGS=true
WORKER_CONCURRENCY=30

# LangSmith tracing: one thread per helpdesk ticket (metadata thread_id = ticket_id)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=momentum-support
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region only

# Optional hardening
# WEBHOOK_SECRET=change-me             # then the helpdesk must send X-Webhook-Secret
# OPERATOR_USERNAME=operator           # HTTP Basic auth for UI and /api/v1
# OPERATOR_PASSWORD=change-me

# Mock helpdesk chaos (probabilities 0..1)
MOCK_FAILURE_RATE=0.2
MOCK_SLOW_RATE=0.1
MOCK_SLOW_SECONDS=12
