# Generate a password, e.g.: openssl rand -base64 32
POSTGRES_USER=support
POSTGRES_PASSWORD=
POSTGRES_DB=support

# --- OpenAI -------------------------------------------------------------------------------------
# Empty key = keyless mode: requests still go to OpenAI, static drafts after a 5-30 s delay.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Product name used in the LLM prompt and in reply signatures
PRODUCT_NAME=Pulsar Analytics

# Global provider budget (chat + embeddings), shared by all workers
RATE_LIMIT_RPM=60
RATE_LIMIT_INCLUDE_EMBEDDINGS=true
WORKER_CONCURRENCY=30

# Optional hardening
# WEBHOOK_SECRET=change-me             # then the helpdesk must send X-Webhook-Secret
# OPERATOR_USERNAME=operator           # HTTP Basic auth for UI and /api/v1
# OPERATOR_PASSWORD=change-me

# --- LangSmith tracing: one thread per helpdesk ticket -----------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=momentum-support
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU-region accounts only

# --- Mock helpdesk (there is no real helpdesk; remove "mock" once one is connected) -------------
COMPOSE_PROFILES=mock
MOCK_FAILURE_RATE=0.2
MOCK_SLOW_RATE=0.1
MOCK_SLOW_SECONDS=12
